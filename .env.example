# Copia este archivo como ".env" (sin .example) y ajusta los valores.
# El archivo .env NO se sube a GitHub: ahí viven las claves de cada computador.

# Base de datos MySQL (coincide con el docker-compose.yml incluido).
# useSSL=false y allowPublicKeyRetrieval=true son solo para desarrollo local.
DB_URL=jdbc:mysql://localhost:3306/knowsis?useSSL=false&allowPublicKeyRetrieval=true
DB_USER=knowsis
DB_PASSWORD=knowsis

# Clave para firmar los JWT: mínimo 32 caracteres. Cámbiala por una propia.
JWT_SECRET=cambia-esta-clave-por-una-de-minimo-32-caracteres

# Origen(es) del frontend permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:5173
